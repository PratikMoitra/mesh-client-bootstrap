# Copy to config.env. Plain KEY=value only; no quotes, expansion, or shell code.
# No credentials, auth keys or invite links belong here.
HEADSCALE_LOGIN_SERVER=https://headscale.example.invalid
TELEPORT_PROXY=teleport.example.invalid:443
# Choose versions compatible with your verified Headscale and Teleport cluster.
# Exact official HTTPS artifact URLs and SHA256 digests; blank = fail closed.
# macOS: Tailscale standalone .pkg, signed Teleport client .pkg.
# Linux: official Tailscale install.sh; Teleport Linux tar.gz matching CPU.
# Windows: official Tailscale .msi; Teleport Windows bin.zip matching CPU.
TAILSCALE_URL=
TAILSCALE_SHA256=
TELEPORT_URL=
TELEPORT_SHA256=
